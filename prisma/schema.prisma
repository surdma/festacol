// Festacol public application schema.
//
// Ownership boundary:
// - Prisma owns the public application schema and migration history.
// - Supabase owns auth.users and platform-only capabilities (Auth, RLS,
//   security-definer RPCs and Realtime/Webhooks).
// - Supabase auth.users is intentionally NOT modeled as a Prisma User table.
// - AcademicProfile.authUserId stores the Supabase Auth UUID. The cross-schema
//   FK to auth.users is installed by Supabase-specific SQL because Prisma does
//   not own the auth schema.
// - ExamAttempt.contextSnapshot is intentional immutable audit context. It is
//   not a second source of truth for live academic entities.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AcademicRole {
  STUDENT       @map("student")
  TEACHER       @map("teacher")
  ADMINISTRATOR @map("administrator")

  @@map("academic_role")
}

enum RecordStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("record_status")
}

enum AcademicPeriodStatus {
  PLANNED  @map("planned")
  ACTIVE   @map("active")
  CLOSED   @map("closed")
  ARCHIVED @map("archived")

  @@map("academic_period_status")
}

enum EnrollmentStatus {
  ACTIVE      @map("active")
  COMPLETED   @map("completed")
  WITHDRAWN   @map("withdrawn")
  TRANSFERRED @map("transferred")
  ENDED       @map("ended")

  @@map("enrollment_status")
}

enum OfferingParticipation {
  REQUIRED @map("required")
  ELECTIVE @map("elective")

  @@map("offering_participation")
}

enum OfferingStatus {
  DRAFT  @map("draft")
  ACTIVE @map("active")
  ENDED  @map("ended")

  @@map("offering_status")
}

enum TeachingAssignmentRole {
  TEACHER      @map("teacher")
  HEAD_TEACHER @map("head_teacher")
  ASSISTANT    @map("assistant")

  @@map("teaching_assignment_role")
}

enum ExamMode {
  QUALIFIER @map("qualifier")
  BECE      @map("bece")
  WAEC      @map("waec")
  NECO      @map("neco")
  JAMB      @map("jamb")
  MIXED     @map("mixed")
  SINGLE    @map("single")

  @@map("exam_mode")
}

enum ExamStatus {
  DRAFT  @map("draft")
  OPEN   @map("open")
  CLOSED @map("closed")

  @@map("exam_status")
}

enum ExamStaffRole {
  COHOST  @map("cohost")
  PROCTOR @map("proctor")

  @@map("exam_staff_role")
}

enum ExamAccessDecision {
  ALLOW @map("allow")
  DENY  @map("deny")

  @@map("exam_access_decision")
}

enum QuestionType {
  SINGLE     @map("single")
  MULTI      @map("multi")
  BOOLEAN    @map("boolean")
  FILL       @map("fill")
  FILL_MULTI @map("fill-multi")

  @@map("question_type")
}

model AcademicProfile {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId String?      @unique @map("auth_user_id") @db.Uuid
  role       AcademicRole
  status     RecordStatus @default(ACTIVE)
  firstName  String       @map("first_name")
  lastName   String       @map("last_name")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  student StudentAcademicProfile?
  staff   StaffAcademicProfile?

  @@index([role, status])
  @@index([firstName, lastName, role, status])
  @@map("academic_profiles")
}

model StudentAcademicProfile {
  profileId       String   @id @map("profile_id") @db.Uuid
  studentNumber   String?  @unique @map("student_number")
  guardian        String   @default("")
  phone           String   @default("")
  promotionStatus String   @default("on-track") @map("promotion_status")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile            AcademicProfile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  classEnrollments   ClassEnrollment[]
  subjectEnrollments StudentSubjectEnrollment[]
  examAccess         ExamStudentAccess[]
  retakeGrants       ExamRetakeGrant[]
  attempts           ExamAttempt[]

  @@map("student_academic_profiles")
}

model StaffAcademicProfile {
  profileId       String   @id @map("profile_id") @db.Uuid
  staffNumber     String?  @unique @map("staff_number")
  qualifierAccess Boolean  @default(false) @map("qualifier_access")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile              AcademicProfile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  qualifications       StaffSubjectQualification[]
  teachingAssignments  TeachingAssignment[]
  createdExams          ExamSession[]                @relation("ExamCreator")
  authoredQuestions     Question[]                   @relation("QuestionAuthor")
  examAssignments       ExamStaffAssignment[]
  grantedExamAccess     ExamStudentAccess[]          @relation("ExamAccessGrantor")
  grantedRetakeGrants   ExamRetakeGrant[]            @relation("ExamRetakeGrantor")

  @@map("staff_academic_profiles")
}

model AcademicYear {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String               @unique
  startsOn  DateTime?            @map("starts_on") @db.Date
  endsOn    DateTime?            @map("ends_on") @db.Date
  status    AcademicPeriodStatus @default(PLANNED)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  terms   AcademicTerm[]
  classes Class[]

  @@map("academic_years")
}

model AcademicTerm {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academicYearId String               @map("academic_year_id") @db.Uuid
  name           String
  sequence       Int
  startsOn       DateTime?            @map("starts_on") @db.Date
  endsOn         DateTime?            @map("ends_on") @db.Date
  status         AcademicPeriodStatus @default(PLANNED)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  academicYear AcademicYear             @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  offerings   ClassSubjectOffering[]
  exams       ExamSession[]

  @@unique([academicYearId, sequence])
  @@unique([academicYearId, name])
  @@map("academic_terms")
}

model AcademicLevel {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  ordinal   Int      @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  classes       Class[]
  questionLinks QuestionAcademicLevel[]

  @@map("academic_levels")
}

model AcademicProgramme {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  classes             Class[]
  examPlacementLinks  ExamPlacementProgramme[]

  @@map("academic_programmes")
}

model Class {
  id             String       @id
  levelId        String       @map("level_id") @db.Uuid
  programmeId    String?      @map("programme_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  arm            String       @default("")
  capacity       Int          @default(40)
  room           String       @default("")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  level            AcademicLevel          @relation(fields: [levelId], references: [id], onDelete: Restrict)
  programme        AcademicProgramme?     @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  academicYear     AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  enrollments      ClassEnrollment[]
  subjectOfferings ClassSubjectOffering[]
  examTargets      ExamClassTarget[]
  whatsappGroup    WhatsappGroup?

  @@index([academicYearId, levelId, programmeId, status])
  @@map("classes")
}

model ClassEnrollment {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentProfileId String           @map("student_profile_id") @db.Uuid
  classId          String           @map("class_id")
  status           EnrollmentStatus @default(ACTIVE)
  enrolledAt       DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  endedAt          DateTime?        @map("ended_at") @db.Timestamptz(6)

  student StudentAcademicProfile @relation(fields: [studentProfileId], references: [profileId], onDelete: Cascade)
  class   Class                  @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@unique([studentProfileId, classId])
  @@index([classId, status])
  @@map("class_enrollments")
}

model Subject {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  offerings      ClassSubjectOffering[]
  qualifications StaffSubjectQualification[]
  questions      Question[]

  @@index([active, name])
  @@map("subjects")
}

model ClassSubjectOffering {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId        String                @map("class_id")
  subjectId      String                @map("subject_id") @db.Uuid
  academicTermId String?               @map("academic_term_id") @db.Uuid
  participation  OfferingParticipation @default(REQUIRED)
  status         OfferingStatus        @default(ACTIVE)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  class               Class                       @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject             Subject                     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  academicTerm        AcademicTerm?               @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  studentEnrollments  StudentSubjectEnrollment[]
  teachingAssignments TeachingAssignment[]
  examTargets         ExamOfferingTarget[]

  @@index([classId, status])
  @@index([subjectId, status])
  @@map("class_subject_offerings")
}

model StudentSubjectEnrollment {
  studentProfileId String           @map("student_profile_id") @db.Uuid
  offeringId       String           @map("offering_id") @db.Uuid
  status           EnrollmentStatus @default(ACTIVE)
  enrolledAt       DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  endedAt          DateTime?        @map("ended_at") @db.Timestamptz(6)

  student  StudentAcademicProfile @relation(fields: [studentProfileId], references: [profileId], onDelete: Cascade)
  offering ClassSubjectOffering   @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, offeringId])
  @@index([offeringId, status])
  @@map("student_subject_enrollments")
}

model StaffSubjectQualification {
  staffProfileId String   @map("staff_profile_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  active         Boolean  @default(true)
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  staff   StaffAcademicProfile @relation(fields: [staffProfileId], references: [profileId], onDelete: Cascade)
  subject Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([staffProfileId, subjectId])
  @@index([subjectId, active])
  @@map("staff_subject_qualifications")
}

model TeachingAssignment {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffProfileId String                 @map("staff_profile_id") @db.Uuid
  offeringId     String                 @map("offering_id") @db.Uuid
  assignmentRole TeachingAssignmentRole @default(TEACHER) @map("assignment_role")
  assignedAt     DateTime               @default(now()) @map("assigned_at") @db.Timestamptz(6)
  endedAt        DateTime?              @map("ended_at") @db.Timestamptz(6)

  staff    StaffAcademicProfile @relation(fields: [staffProfileId], references: [profileId], onDelete: Cascade)
  offering ClassSubjectOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  @@unique([staffProfileId, offeringId])
  @@index([offeringId, endedAt])
  @@map("teaching_assignments")
}

model ExamSession {
  id                 String     @id
  title              String
  academicTermId     String?    @map("academic_term_id") @db.Uuid
  mode               ExamMode
  status             ExamStatus @default(DRAFT)
  durationSeconds    Int        @map("duration_seconds")
  questionCount      Int        @map("question_count")
  instructions       String     @default("")
  startsAt           BigInt?    @map("starts_at")
  endsAt             BigInt?    @map("ends_at")
  attemptLimit       Int        @default(1) @map("attempt_limit")
  focusMonitoring    Boolean    @default(true) @map("focus_monitoring")
  fullscreenPrompt   Boolean    @default(true) @map("fullscreen_prompt")
  clipboardGuard     Boolean    @default(true) @map("clipboard_guard")
  cameraRequired     Boolean    @default(false) @map("camera_required")
  warnAfter          Int        @default(2) @map("warn_after")
  questionOrder      Boolean    @default(true) @map("question_order")
  optionOrder        Boolean    @default(true) @map("option_order")
  minimizeCollisions Boolean    @default(true) @map("minimize_collisions")
  createdByProfileId String?    @map("created_by_profile_id") @db.Uuid
  createdAt          BigInt     @map("created_at")
  updatedAt          BigInt     @map("updated_at")

  academicTerm     AcademicTerm?         @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  creator          StaffAcademicProfile? @relation("ExamCreator", fields: [createdByProfileId], references: [profileId], onDelete: SetNull)
  classTargets        ExamClassTarget[]
  offeringTargets     ExamOfferingTarget[]
  placementProgrammes ExamPlacementProgramme[]
  staffAssignments ExamStaffAssignment[]
  studentAccess    ExamStudentAccess[]
  retakeGrants     ExamRetakeGrant[]
  attempts         ExamAttempt[]

  @@index([status, startsAt, endsAt])
  @@index([createdByProfileId])
  @@map("exam_sessions")
}

model ExamClassTarget {
  sessionId String   @map("session_id")
  classId   String   @map("class_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  class   Class       @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@id([sessionId, classId])
  @@map("exam_class_targets")
}

model ExamOfferingTarget {
  sessionId  String   @map("session_id")
  offeringId String   @map("offering_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session  ExamSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  offering ClassSubjectOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  @@id([sessionId, offeringId])
  @@index([offeringId])
  @@map("exam_offering_targets")
}


model ExamPlacementProgramme {
  sessionId   String @map("session_id")
  programmeId String @map("programme_id") @db.Uuid

  session   ExamSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  programme AcademicProgramme @relation(fields: [programmeId], references: [id], onDelete: Restrict)

  @@id([sessionId, programmeId])
  @@index([programmeId])
  @@map("exam_placement_programmes")
}

model ExamStaffAssignment {
  sessionId      String        @map("session_id")
  staffProfileId String        @map("staff_profile_id") @db.Uuid
  role           ExamStaffRole @default(COHOST)
  assignedAt     DateTime      @default(now()) @map("assigned_at") @db.Timestamptz(6)

  session ExamSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staff   StaffAcademicProfile @relation(fields: [staffProfileId], references: [profileId], onDelete: Cascade)

  @@id([sessionId, staffProfileId])
  @@map("exam_staff_assignments")
}

model ExamStudentAccess {
  sessionId           String             @map("session_id")
  studentProfileId    String             @map("student_profile_id") @db.Uuid
  decision            ExamAccessDecision
  maxAttemptsOverride Int?               @map("max_attempts_override")
  validFrom           DateTime?          @map("valid_from") @db.Timestamptz(6)
  validUntil          DateTime?          @map("valid_until") @db.Timestamptz(6)
  grantedByProfileId  String?            @map("granted_by_profile_id") @db.Uuid
  reason              String             @default("")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  session   ExamSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   StudentAcademicProfile @relation(fields: [studentProfileId], references: [profileId], onDelete: Cascade)
  grantedBy StaffAcademicProfile?  @relation("ExamAccessGrantor", fields: [grantedByProfileId], references: [profileId], onDelete: SetNull)

  @@id([sessionId, studentProfileId])
  @@map("exam_student_access")
}

model ExamRetakeGrant {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId          String    @map("session_id")
  studentProfileId   String    @map("student_profile_id") @db.Uuid
  additionalAttempts Int       @default(1) @map("additional_attempts")
  grantedByProfileId String    @map("granted_by_profile_id") @db.Uuid
  reason             String    @default("")
  grantedAt          DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)

  session   ExamSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   StudentAcademicProfile @relation(fields: [studentProfileId], references: [profileId], onDelete: Cascade)
  grantedBy StaffAcademicProfile   @relation("ExamRetakeGrantor", fields: [grantedByProfileId], references: [profileId], onDelete: Restrict)

  @@index([sessionId, studentProfileId, revokedAt, expiresAt])
  @@map("exam_retake_grants")
}

model ExamAttempt {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId              String   @map("session_id")
  studentProfileId       String   @map("student_profile_id") @db.Uuid
  attemptNumber          Int      @map("attempt_number")
  contextSnapshot        Json     @default("{}") @map("context_snapshot")
  startedAt              BigInt?  @map("started_at")
  submittedAt            BigInt?  @map("submitted_at")
  score                  Float?
  correctCount           Float?   @map("correct_count")
  completion             Float?
  paceIndex              Float?   @map("pace_index")
  reasoningIndex         Float?   @map("reasoning_index")
  integrityScore         Float?   @map("integrity_score")
  assignedTrack          String?  @map("assigned_track")
  placementConfidence    Int?     @map("placement_confidence")
  submissionReason       String   @default("") @map("submission_reason")
  rewriteSourceAttemptId String?  @map("rewrite_source_attempt_id") @db.Uuid
  createdAt              BigInt   @default(dbgenerated("(EXTRACT(epoch FROM now()) * 1000)::bigint")) @map("created_at")

  session         ExamSession             @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student         StudentAcademicProfile  @relation(fields: [studentProfileId], references: [profileId], onDelete: Restrict)
  rewriteSource   ExamAttempt?            @relation("AttemptRewrite", fields: [rewriteSourceAttemptId], references: [id], onDelete: SetNull)
  rewrites        ExamAttempt[]           @relation("AttemptRewrite")
  runtimeState    ExamAttemptRuntimeState?
  responses       ExamAttemptResponse[]
  answers         ExamAttemptAnswer[]
  integrityEvents ExamIntegrityEvent[]

  @@unique([sessionId, studentProfileId, attemptNumber])
  @@index([studentProfileId, createdAt])
  @@index([sessionId, createdAt])
  @@map("exam_attempts")
}

model ExamAttemptRuntimeState {
  attemptId            String   @id @map("attempt_id") @db.Uuid
  currentIndex         Int      @default(0) @map("current_index")
  remainingSeconds     Float    @map("remaining_seconds")
  elapsedActiveSeconds Float    @default(0) @map("elapsed_active_seconds")
  lastActiveAt         BigInt   @map("last_active_at")
  paperFingerprint     String   @map("paper_fingerprint")
  questionIds          BigInt[] @default([]) @map("question_ids")
  updatedAt            BigInt   @map("updated_at")

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("exam_attempt_runtime_states")
}

model ExamAttemptResponse {
  attemptId      String   @map("attempt_id") @db.Uuid
  questionId     BigInt   @map("question_id")
  responseText   String?  @map("response_text")
  responseValues String[] @default([]) @map("response_values")
  seconds        Float    @default(0)
  flagged        Boolean  @default(false)

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([attemptId, questionId])
  @@map("exam_attempt_responses")
}

model ExamAttemptAnswer {
  attemptId      String   @map("attempt_id") @db.Uuid
  questionId     BigInt   @map("question_id")
  correct        Boolean?
  responseText   String?  @map("response_text")
  responseValues String[] @default([]) @map("response_values")
  correctAnswer  String   @default("") @map("correct_answer")
  seconds        Float    @default(0)

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([attemptId, questionId])
  @@map("exam_attempt_answers")
}

model ExamIntegrityEvent {
  id        BigInt @id @default(autoincrement())
  attemptId String @map("attempt_id") @db.Uuid
  type      String
  detail    String @default("")
  at        BigInt

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, at])
  @@map("exam_integrity_events")
}

model Question {
  id                 BigInt       @id
  subjectId          String       @map("subject_id") @db.Uuid
  qtype              QuestionType
  prompt             String
  options            String[]     @default([])
  correctAnswers     String[]     @default([]) @map("correct_answers")
  fillTemplate       String?      @map("fill_template")
  instruction        String       @default("")
  examModes          ExamMode[]   @default([]) @map("exam_modes")
  difficulty         String       @default("medium")
  domain             String       @default("")
  explanation        String       @default("")
  status             RecordStatus @default(ACTIVE)
  createdByProfileId String?      @map("created_by_profile_id") @db.Uuid
  createdAt          DateTime?    @map("created_at") @db.Timestamptz(6)
  updatedAt          BigInt       @map("updated_at")

  subject          Subject                 @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  creator          StaffAcademicProfile?   @relation("QuestionAuthor", fields: [createdByProfileId], references: [profileId], onDelete: SetNull)
  levels           QuestionAcademicLevel[]
  blanks           QuestionBlank[]
  runtimeResponses ExamAttemptResponse[]
  answerRows       ExamAttemptAnswer[]

  @@index([subjectId])
  @@map("questions")
}

model QuestionAcademicLevel {
  questionId BigInt @map("question_id")
  levelId    String @map("level_id") @db.Uuid

  question Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  level    AcademicLevel @relation(fields: [levelId], references: [id], onDelete: Restrict)

  @@id([questionId, levelId])
  @@index([levelId])
  @@map("question_academic_levels")
}

model QuestionBlank {
  questionId  BigInt   @map("question_id")
  position    Int
  blankKey    String   @map("blank_key")
  placeholder String   @default("")
  accepted    String[] @default([])

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([questionId, position])
  @@unique([questionId, blankKey])
  @@map("question_blanks")
}

model WhatsappGroup {
  id        String @id
  classId   String @unique @map("class_id")
  name      String
  inviteUrl String @map("invite_url")
  createdAt BigInt @map("created_at")
  updatedAt BigInt @map("updated_at")

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("whatsapp_groups")
}
