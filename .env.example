# Copy to .env and fill in. Never commit .env.
# Prisma migrate target (Supabase Postgres). Use pooler for app, direct for migrate.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?schema=public"

# Supabase — required in codebase (SSR + browser + admin)
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# Verifies Supabase Database Webhook calls to /api/realtime/webhook.
SUPABASE_WEBHOOK_SECRET="[RANDOM_32B]"

# Gates POST /api/admin/bootstrap (first-admin provisioning). Set once,
# create the admin, then rotate/remove. Never expose client-side.
SETUP_SECRET="[RANDOM_32B]"
