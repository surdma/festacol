# Copy to .env and fill in. Never commit .env.
# Prisma migrate target (Supabase Postgres). Use the session-mode pooler
# (IPv4) for migrations — the direct db.[REF] host is IPv6-only and fails
# with P1001 on IPv4-only networks.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# App runtime (when using Prisma with a driver adapter): transaction pooler.
# DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase — required in codebase (SSR + browser + admin)
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# Verifies Supabase Database Webhook calls to /api/realtime/webhook.
SUPABASE_WEBHOOK_SECRET="[RANDOM_32B]"

# Gates POST /api/admin/bootstrap (first-admin provisioning). Set once,
# create the admin, then rotate/remove. Never expose client-side.
SETUP_SECRET="[RANDOM_32B]"
